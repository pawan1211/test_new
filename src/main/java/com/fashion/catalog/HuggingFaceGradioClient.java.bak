/** Raw Gradio queue adapter for the published yisol/IDM-VTON Space interface. */
@Component
public class HuggingFaceGradioClient {
    private static final int MAX_RESULT_BYTES = 15 * 1024 * 1024;

    // Injected from configuration rather than held as a literal. The token used
    // to be a hardcoded field initialiser, so the credential was baked into the
    // JAR, could not be rotated without a rebuild, and `configured()` reported
    // "ready" on every deployment regardless of the environment. An empty
    // configured token is the honest, fail-closed state.
    private final String token;
    private final String spaceId;

    private final URI baseUri;




private final HttpClient http =
        HttpClient.newBuilder()
                .connectTimeout(Duration.ofSeconds(10))
                .followRedirects(HttpClient.Redirect.NEVER)
                .build();

private final ObjectMapper mapper;

private volatile Instant schemaCheckedAt = Instant.EPOCH;

@Autowired
public HuggingFaceGradioClient(ObjectMapper mapper) {
    this.mapper = mapper;
}





